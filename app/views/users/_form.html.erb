<%= form_with model: user, class: "form-grid", data: { controller: "location-cascade" } do |form| %>
  <%= render "shared/errors", record: user %>

  <fieldset>
    <legend>Identity</legend>
    <label>First name <%= form.text_field :firstname, required: true %></label>
    <label>Last name <%= form.text_field :lastname, required: true %></label>
    <label>Email <%= form.email_field :email, required: true %></label>
    <label>Mobile <%= form.telephone_field :mobile %></label>
    <label>User type <%= form.select :user_type, @assignable_roles.pluck(:name) | [ user.user_type ].compact, include_blank: "Unassigned" %></label>
    <label>
      Profile photo
      <% if user.profile_image.attached? %>
        <span><%= image_tag url_for(user.profile_image), alt: "Current profile photo", class: "profile-photo" %></span>
      <% end %>
      <%= form.file_field :profile_image, accept: "image/jpeg,image/png,image/webp", capture: "user" %>
      <span class="muted">Upload a JPG, PNG or WebP image, or use the camera on a mobile device.</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>Access</legend>
    <label>Role <%= form.select :role_id, @assignable_roles.collect { |r| [ r.name, r.id ] }, include_blank: "Unassigned" %></label>
    <label>Department <%= form.collection_select :department_id, @departments, :id, :name, include_blank: "Unassigned" %></label>
    <% if user.persisted? %>
      <label>Password <%= form.password_field :password, placeholder: "Leave blank to keep current password", minlength: 12 %></label>
    <% else %>
      <label>Password <%= form.password_field :password, required: true, minlength: 12 %></label>
    <% end %>
    <label class="checkbox"><%= form.check_box :active %> Active account</label>
  </fieldset>

  <fieldset>
    <legend>Residence</legend>
    <label>Primary site <%= form.collection_select :current_site_id, @sites, :id, :display_name, { include_blank: "No site" }, { data: { location_level: "site" } } %></label>
    <label>Building <%= form.select :building_id, building_options(@buildings), { include_blank: "No building" }, { data: { location_level: "building" } } %></label>
    <label>Floor <%= form.select :floor_id, floor_options(@floors), { include_blank: "No floor" }, { data: { location_level: "floor" } } %></label>
    <label>Primary unit <%= form.select :unit_id, unit_options(@units), { include_blank: "No unit / site-only" }, { data: { location_level: "unit" } } %></label>
    <p class="muted">Only buildings, floors and units that belong to the selected site are shown.</p>
    <label>Company ID <%= form.number_field :company_id %></label>
  </fieldset>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancel", users_path %>
  </div>
<% end %>