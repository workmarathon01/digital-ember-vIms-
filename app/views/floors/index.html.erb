<section class="page-title">
  <div>
    <h1>Floors</h1>
    <p class="muted">Floors group units inside a building.</p>
  </div>
  <% if current_user.can?(:floors, :create) %>
    <%= link_to "New floor", new_floor_path, class: "button" %>
  <% end %>
</section>

<%= form_with url: floors_path, method: :get, class: "filters", data: { controller: "location-cascade", location_cascade_allow_blank_parents: "true" } do |form| %>
  <label>Search <%= form.search_field :q, value: params[:q], placeholder: "Floor name" %></label>
  <label>Site <%= form.select :site_id, site_options(@sites), { include_blank: "All sites", selected: params[:site_id] }, { data: { location_level: "site" } } %></label>
  <label>Building <%= form.select :building_id, building_options(@buildings), { include_blank: "All buildings", selected: params[:building_id] }, { data: { location_level: "building" } } %></label>
  <%= form.submit "Filter" %>
  <%= link_to "Clear", floors_path %>
<% end %>

<section class="panel">
  <table>
    <thead><tr><th>Floor</th><th>Building</th><th>Site</th><th>Level</th><th>Units</th><th>Residents</th><th></th></tr></thead>
    <tbody>
      <% @floors.each do |floor| %>
        <tr>
          <td><%= link_to floor.name, floor %></td>
          <td><%= link_to floor.building.name, floor.building %></td>
          <td><%= link_to floor.site.display_name, floor.site %></td>
          <td><%= floor.level %></td>
          <td><%= floor.units.size %></td>
          <td><%= floor.user_sites.size %></td>
          <td><%= link_to "Open", floor %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<%= render "shared/pagination", pagy: @pagy %>
