<table>
  <thead>
    <tr>
      <th>When</th>
      <th>Actor</th>
      <th>Action</th>
      <th>Resource</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    <% logs.each do |log| %>
      <tr>
        <td><%= time_ago_in_words(log.created_at) %> ago</td>
        <td><%= log.actor_name %></td>
        <td><span class="pill"><%= log.action %></span></td>
        <td><%= log.resource_name %></td>
        <td class="muted">
          <% if log.details.is_a?(Hash) && log.details.any? %>
            <%= log.details.to_json.truncate(80) %>
          <% else %>
            &mdash;
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>