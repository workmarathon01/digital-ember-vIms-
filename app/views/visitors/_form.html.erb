<%= form_with model: visitor, class: "form-grid", data: { controller: "visitor-host location-cascade", visitor_host_url_value: public_hosts_path, visitor_host_selected_value: visitor.vhost_id } do |form| %>
  <%= render "shared/errors", record: visitor %>

  <fieldset>
    <legend>Guest</legend>
    <label>Name <%= form.text_field :name, required: true %></label>
    <label>Contact <%= form.telephone_field :contact_no, required: true %></label>
    <label>Profile photo
      <% if visitor.profile_image.attached? %>
        <span><%= image_tag url_for(visitor.profile_image), alt: "Current profile photo", class: "profile-photo" %></span>
      <% end %>
      <%= form.file_field :profile_image, accept: "image/jpeg,image/png,image/webp", capture: "user" %>
    </label>
    <label>Purpose <%= form.text_area :purpose, rows: 3 %></label>
    <label>Coming from <%= form.text_field :coming_from %></label>
    <label>Vehicle number <%= form.text_field :vehicle_number %></label>
  </fieldset>

  <fieldset>
    <legend>Visit plan</legend>
    <label>Visit type <%= form.select :visit_type, [ "Guest", "Contractor", "Staff", "Delivery", "Other" ], include_blank: true %></label>
    <label>Frequency <%= form.text_field :frequency, placeholder: "Once / Daily / Weekly" %></label>
    <label>Expected date <%= form.date_field :expected_date %></label>
    <label>Expected time <%= form.time_field :expected_time %></label>
    <label>Site <%= form.select :site_id, site_options(@sites), { include_blank: "Unassigned" }, { data: { location_level: "site" } } %></label>
    <label>Building <%= form.select :building_id, building_options(@buildings), { include_blank: "No building" }, { data: { location_level: "building" } } %></label>
    <label>Floor <%= form.select :floor_id, floor_options(@floors), { include_blank: "No floor" }, { data: { location_level: "floor" } } %></label>
    <label>Unit <%= form.select :unit_id, unit_options(@units), { include_blank: "No unit" }, { data: { location_level: "unit", visitor_host_target: "unit", action: "change->visitor-host#refresh" } } %></label>
    <label>Host / Resident <%= form.select :vhost_id, (@hosts || []).map { |host| [ host.full_name, host.id ] }, { include_blank: "Select host" }, { data: { visitor_host_target: "host" } } %></label>
    <p class="muted">Selecting a site narrows the building, floor and unit lists. Selecting a unit narrows the host list to residents linked to that unit.</p>
  </fieldset>

  <fieldset>
    <legend>Pass window</legend>
    <label>Starts <%= form.datetime_local_field :start_pass %></label>
    <label>Ends <%= form.datetime_local_field :end_pass %></label>
    <label class="checkbox"><%= form.check_box :skip_host_approval %> Skip host approval</label>
    <label class="checkbox"><%= form.check_box :goods_inwards %> Goods inwards</label>
    <label class="checkbox"><%= form.check_box :driving_license %> Driving license on file</label>
    <label class="checkbox"><%= form.check_box :consignment_form %> Consignment form</label>
  </fieldset>

  <div class="form-actions">
    <%= form.submit visitor.persisted? ? "Update pass" : "Issue pass" %>
    <%= link_to "Cancel", visitors_path %>
  </div>
<% end %>