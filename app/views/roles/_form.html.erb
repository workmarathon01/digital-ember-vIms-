<%= form_with model: role, class: "form-grid" do |form| %>
  <%= render "shared/errors", record: role %>

  <fieldset>
    <legend>Details</legend>
    <label>Name <%= form.text_field :name, required: true %></label>
    <label>Key <%= form.text_field :key, placeholder: "e.g. concierge" %></label>
    <label>Description <%= form.text_area :description, rows: 2 %></label>
    <label>Power level <%= form.number_field :power_level, min: 1, max: 100 %></label>
    <label class="checkbox"><%= form.check_box :active %> Active</label>
  </fieldset>

  <% if role.persisted? %>
    <fieldset>
      <legend>Permissions</legend>
      <p class="muted">Tick the actions each resource grants this role. The System Administrator role is always all-access.</p>
      <% Role::RESOURCES.each do |resource| %>
        <div class="permission-group">
          <h3><%= resource[:label] %></h3>
          <div class="permission-row">
            <% resource[:actions].each do |action| %>
              <label class="permission-cell">
                <%= check_box_tag "permissions[#{resource[:key]}:#{action}]", "1",
                                  role.super_admin? || role.permission_for?(resource).include?(action),
                                  disabled: role.super_admin? %>
                <%= action.titleize %>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </fieldset>
  <% end %>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancel", roles_path %>
  </div>
<% end %>